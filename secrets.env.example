# Copy this file to secrets.env and fill in the values.
# secrets.env is gitignored; do not commit it.

# 사람인 채용정보 API (선택)
SARAMIN_ACCESS_KEY=

# 카카오맵 (developers.kakao.com에서 앱 생성 후 발급)
# REST API 키: 수집 시 기관명 -> 좌표 변환에 사용
KAKAO_REST_API_KEY=
# JavaScript 키: 검토 UI 지도 표시에 사용 (플랫폼에 http://127.0.0.1:8765 등록 필요)
KAKAO_JS_KEY=

# Claude API (선택) - --llm-fields --llm-backend api 일 때만 필요.
# 기본값(claude-code)은 로그인된 Claude Code를 쓰므로 키가 필요 없음
ANTHROPIC_API_KEY=

# 공개 사이트 (build_site.py) - 모두 선택
# 사이트 주소: canonical 링크와 sitemap.xml에 사용
SITE_URL=
# 알림 신청 폼이 POST할 주소
ALERT_ENDPOINT=
# 애드센스 게시자 ID (ca-pub-...)
ADSENSE_CLIENT=
